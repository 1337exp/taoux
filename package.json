{
  "name": "@1337exp/taoux",
  "version": "0.5.5",
  "description": "Interaction and behavior building blocks for Vue apps: curve and gradient editors, canvas, undo/redo, playback. Import only what you need, bring your own design.",
  "keywords": [
    "vue",
    "ux",
    "typescript",
    "canvas",
    "undo-redo",
    "composables",
    "i18n",
    "playback",
    "curve-editor",
    "gradient-editor",
    "vue3",
    "nuxt",
    "design-tokens",
    "taoui"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/1337exp/taoux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1337exp/taoux.git"
  },
  "bugs": {
    "url": "https://github.com/1337exp/taoux/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "theme",
    "CHANGELOG.md",
    "skills"
  ],
  "exports": {
    "./camera": {
      "types": "./dist/camera.d.ts",
      "import": "./dist/camera.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas.js"
    },
    "./canvas.css": "./dist/canvas.css",
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./curve": {
      "types": "./dist/curve.d.ts",
      "import": "./dist/curve.js"
    },
    "./curveeditor": {
      "types": "./dist/curveeditor/index.d.ts",
      "import": "./dist/curveeditor.js"
    },
    "./curveeditor.css": "./dist/curveeditor.css",
    "./curvefield": {
      "types": "./dist/curvefield/index.d.ts",
      "import": "./dist/curvefield.js"
    },
    "./curvefield.css": "./dist/curvefield.css",
    "./ease": {
      "types": "./dist/ease.d.ts",
      "import": "./dist/ease.js"
    },
    "./edgescroll": {
      "types": "./dist/edgescroll.d.ts",
      "import": "./dist/edgescroll.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "import": "./dist/file.js"
    },
    "./gestures": {
      "types": "./dist/gestures.d.ts",
      "import": "./dist/gestures.js"
    },
    "./gradienteditor": {
      "types": "./dist/gradienteditor/index.d.ts",
      "import": "./dist/gradienteditor.js"
    },
    "./gradienteditor.css": "./dist/gradienteditor.css",
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./hotkeys": {
      "types": "./dist/hotkeys.d.ts",
      "import": "./dist/hotkeys.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "import": "./dist/ids.js"
    },
    "./links": {
      "types": "./dist/links/index.d.ts",
      "import": "./dist/links.js"
    },
    "./links.css": "./dist/links.css",
    "./num": {
      "types": "./dist/num.d.ts",
      "import": "./dist/num.js"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "import": "./dist/palette.js"
    },
    "./pins": {
      "types": "./dist/pins.d.ts",
      "import": "./dist/pins.js"
    },
    "./playback": {
      "types": "./dist/playback/index.d.ts",
      "import": "./dist/playback.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./snap": {
      "types": "./dist/snap.d.ts",
      "import": "./dist/snap.js"
    },
    "./sortable": {
      "types": "./dist/sortable.d.ts",
      "import": "./dist/sortable.js"
    },
    "./swiperow": {
      "types": "./dist/swiperow/index.d.ts",
      "import": "./dist/swiperow.js"
    },
    "./swiperow.css": "./dist/swiperow.css",
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./touch": {
      "types": "./dist/touch.d.ts",
      "import": "./dist/touch.js"
    },
    "./undo": {
      "types": "./dist/undo.d.ts",
      "import": "./dist/undo.js"
    },
    "./wheel": {
      "types": "./dist/wheel.d.ts",
      "import": "./dist/wheel.js"
    },
    "./taoui.css": "./theme/taoui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "sandbox": "vite --config vite.sandbox.config.ts",
    "sandbox:build": "vite build --config vite.sandbox.config.ts",
    "sandbox:preview": "vite preview --config vite.sandbox.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/consumer-smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "media": "node scripts/media.mjs"
  },
  "peerDependencies": {
    "@1337exp/taoui": "^5.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@1337exp/taoui": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@1337exp/taoui": "^5.6.2",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  },
  "author": "1337exp",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
